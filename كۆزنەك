    <script>
        window.addEventListener('load', () => {
            setTimeout(() => {
                const splash = document.getElementById('splashScreen');
                if (splash) {
                    splash.style.opacity = '0';
                    setTimeout(() => { 
                        splash.style.display = 'none'; 
                        showWelcomePopup();
                    }, 500);
                }
            }, 1800);
        });

        function showWelcomePopup() {
            const popup = document.getElementById('welcomePopup');
            if (!sessionStorage.getItem('popupClosed')) {
                popup.style.display = 'flex';
            }
        }

        function closePopup() {
            const popup = document.getElementById('welcomePopup');
            popup.style.display = 'none';
            sessionStorage.setItem('popupClosed', 'true');
        }

        const ADMIN_USERNAME = "nasrulla";
        const ADMIN_MASTER_PASS = "0996";

        let movies = [];
        let globalUsersDb = {};
        let currentCategory = 'all';
        let currentUser = null;
        let favorites = [];
        let selectedActionUser = null;
        let uploadedPosterBase64 = "";

        try {
            currentUser = JSON.parse(localStorage.getItem('koznek_current_user')) || null;
            favorites = JSON.parse(localStorage.getItem('koznek_favs')) || [];
        } catch (e) {}

        let currentThemeMode = localStorage.getItem('koznek_theme_mode') || 'system';
        applyThemeMode(currentThemeMode);

        const searchModal = document.getElementById('searchModal');
        const searchInput = document.getElementById('searchInput');
        const searchResults = document.getElementById('searchResults');
        const detailPage = document.getElementById('detailPage');

        window.initFirebaseApp = function() {
            const moviesRef = window.dbRef(window.db, 'koznek_movies');
            window.dbOnValue(moviesRef, (snapshot) => {
                const data = snapshot.val();
                if (data) {
                    movies = Object.values(data);
                } else {
                    movies = [];
                    window.dbSet(moviesRef, movies);
                }
                renderHomeSections();
                renderShortsFeed();
            });

            const usersRef = window.dbRef(window.db, 'koznek_users_db');
            window.dbOnValue(usersRef, (snapshot) => {
                const data = snapshot.val();
                globalUsersDb = data || {};
                
                if (currentUser) {
                    for (let k in globalUsersDb) {
                        if (k.trim().toLowerCase() === currentUser.name.toLowerCase()) {
                            currentUser.vipExpire = globalUsersDb[k].vipExpire || 0;
                            currentUser.avatar = globalUsersDb[k].avatar || '';
                            localStorage.setItem('koznek_current_user', JSON.stringify(currentUser));
                            break;
                        }
                    }
                }
                checkAdminPermissions();
                updateAccountUI();
            });
        };

        function handlePhoneImageSelected(event) {
            if (!currentUser) {
                alert('ئەvvəl ھېساباتقا كىرىڭ ياكى تىزىملىتىڭ!');
                return;
            }
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(uploadEvent) {
                const base64String = uploadEvent.target.result;

                const userRef = window.dbRef(window.db, 'koznek_users_db/' + currentUser.name);
                let userData = globalUsersDb[currentUser.name] || {};
                userData.avatar = base64String;
                userData.vipExpire = currentUser.vipExpire || 0;

                window.dbSet(userRef, userData).then(() => {
                    currentUser.avatar = base64String;
                    localStorage.setItem('koznek_current_user', JSON.stringify(currentUser));
                    updateAccountUI();
                    alert('شەخسىي رەسىمى مۇۋەپپەقىيەتلىك ئۆزگەرتىلدى!');
                });
            };
            reader.readAsDataURL(file);
        }

        function handleMoviePosterSelected(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(uploadEvent) {
                uploadedPosterBase64 = uploadEvent.target.result;
                const previewBox = document.getElementById('posterPreviewBox');
                if (previewBox) {
                    previewBox.innerHTML = `<img src="${uploadedPosterBase64}" style="width:100%; height:100%; object-fit:cover; border-radius:10px;">`;
                }
            };
            reader.readAsDataURL(file);
        }

        function checkAdminPermissions() {
            const isAdmin = currentUser && currentUser.name.toLowerCase() === ADMIN_USERNAME;
            const uploadTabContent = document.getElementById('uploadPageContent');
            const navUploadBtn = document.getElementById('navUploadBtn');
            const uploadMenuSettingItem = document.getElementById('uploadMenuSettingItem');

            if (isAdmin) {
                navUploadBtn.style.display = 'flex';
                uploadMenuSettingItem.style.display = 'flex';

                let usersListHtml = '';
                let now = new Date().getTime();
                let userCount = 0;

                for (let username in globalUsersDb) {
                    if (username.toLowerCase() === ADMIN_USERNAME) continue;
                    userCount++;
                    let vExpire = globalUsersDb[username].vipExpire || 0;
                    let uAvatar = globalUsersDb[username].avatar || '';
                    let isVipActive = vExpire > now;
                    let statusDesc = 'ئەزالىق يوق';

                    if (isVipActive) {
                        let diffMs = vExpire - now;
                        let leftDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
                        let leftHours = Math.floor((diffMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        statusDesc = `⭐ VIP (قالدى: ${leftDays} كۈن ${leftHours} سائەت)`;
                    }

                    let avatarHtml = uAvatar ? `<img src="${uAvatar}" onerror="this.parentElement.innerHTML='👤'">` : '👤';

                    usersListHtml += `
                        <div class="swipe-wrapper" id="swipe-${username}">
                            <div class="swipe-delete-bg">🗑️ يۇيۋىتىش</div>
                            <div class="user-list-item" data-username="${username}" onclick="openUserActionModal('${username}')">
                                <div class="user-info-box">
                                    <div class="user-avatar-mini">${avatarHtml}</div>
                                    <div class="user-text-details">
                                        <span class="user-name-txt">👤 ${username}</span>
                                        <span class="user-status-txt">${statusDesc}</span>
                                    </div>
                                </div>
                                <div style="font-size: 11px; color: var(--text-secondary);">باسسىڭىز تەڭشىلىدۇ</div>
                            </div>
                        </div>
                    `;
                }

                if (userCount === 0) {
                    usersListHtml = '<div style="color: var(--text-secondary); text-align: center; margin: 15px 0;">ھازىرچە توردا باشقا تىزىملاتقان ئەزا يوق</div>';
                }

                const existingUsersContainer = document.getElementById('allUsersContainer');
                if (existingUsersContainer) {
                    existingUsersContainer.innerHTML = usersListHtml;
                    initSwipeGestures();
                } else {
                    uploadTabContent.innerHTML = `
                        <div class="section-title">مەزمۇن قاچىلاش ۋە باشقۇرۇش</div>
                        <div class="form-group" style="margin-top: 14px;">
                            <label>مەزمۇن نامى</label>
                            <input type="text" id="newMovieTitle" class="form-input" placeholder="مەسىلەن: شاھزادە داستانى" autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label>تۈرى (Category)</label>
                            <select id="newMovieCat" class="form-select" onchange="toggleSeriesInputs()">
                                <option value="movie">كىنولار (بىرتاللا)</option>
                                <option value="series">قىسىملىق كىنولەر (كۆپ قىسىملىق)</option>
                                <option value="cartoon">🧸 كارتونلار (بىرتاللا)</option>
                                <option value="cartoon_series">🧸📺 قىسىملىق كارتۇن (كۆپ قىسىملىق)</option>
                                <option value="short">📱 قىسقا فىلىملەر</option>
                            </select>
                        </div>

                        <div id="seriesExtraInputs" style="display: none; background: var(--card-bg); padding: 14px; border-radius: 10px; border: 1px solid var(--border-color); margin-bottom: 16px;">
                            <div class="form-group" style="margin-bottom: 10px;">
                                <label>قىسىم سانى (مەسىلەن: 5)</label>
                                <input type="number" id="seriesTotalCount" class="form-input" value="5" min="1" max="50" oninput="renderEpisodeInputs()">
                            </div>
                            <div style="font-size: 11px; color: var(--accent-color); margin-bottom: 10px;">* تۆۋەندە ھەر بىر قىسىم ئۈچۈن ۋىدېئو ئادرېسىنى كىرگۈزۈڭ:</div>
                            <div id="episodesInputsList" style="display: flex; flex-direction: column; gap: 10px; max-height: 220px; overflow-y: auto; padding-left: 5px;"></div>
                        </div>

                        <div class="form-group">
                            <label>ئەزا تىپى (Access)</label>
                            <select id="newMovieAccess" class="form-select">
                                <option value="free">ھەممىگە ھەقسىز (Free)</option>
                                <option value="vip">پەقەت VIP ئەزالار ئۈچۈن (⭐ VIP)</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label>مۇقاۋا رەسىم (تېلېفوندىن تاللاش)</label>
                            <div id="posterPreviewBox" onclick="document.getElementById('moviePosterFile').click()" style="width: 100%; height: 120px; background: var(--card-bg); border: 2px dashed var(--border-color); border-radius: 10px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text-secondary); font-size: 13px;">
