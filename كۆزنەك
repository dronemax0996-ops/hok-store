        .profile-username-txt { font-size: 17px; font-weight: 800; color: var(--text-color); }
        .profile-role-txt { font-size: 12px; color: var(--text-secondary); }

        .profile-buttons-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .profile-action-chip {
            background: var(--bg-color); border: 1px solid var(--border-color); padding: 12px 14px;
            border-radius: 12px; display: flex; align-items: center; justify-content: center; gap: 8px;
