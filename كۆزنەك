        .card-actions { display: flex; align-items: center; gap: 8px; }
        .fav-btn { background: none; border: none; font-size: 16px; cursor: pointer; color: var(--text-secondary); padding: 4px; }
        .fav-btn.liked { color: var(--accent-color); }
        .del-btn { background: none; border: none; font-size: 15px; cursor: pointer; color: #ff4757; padding: 4px; }

        /* TikTok / Kuaishou ئۇسلۇبىدىكى قىسقا فىلىم ئېكرانى */
