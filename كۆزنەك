        .user-action-card {
            background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 16px;
            width: 100%; max-width: 320px; padding: 24px; text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }
        .user-action-title { font-size: 16px; font-weight: 700; margin-bottom: 20px; color: var(--text-color); }
        .popup-btn { width: 100%; padding: 12px; border-radius: 8px; font-size: 14px; font-weight: 700; border: none; cursor: pointer; margin-bottom: 10px; }
        .popup-btn-add { background-color: #2ed573; color: white; }
        .popup-btn-sub { background-color: #ffa502; color: white; }
        .popup-btn-revoke { background-color: #ff4757; color: white; }
        .popup-btn-close { background-color: #444; color: white; margin-bottom: 0; }

        .settings-page-wrapper { max-width: 450px; margin: 15px auto; padding: 0 15px; }

        .user-profile-card {
            background: var(--card-bg); border: 1px solid var(--border-color);
            border-radius: 20px; padding: 22px; margin-bottom: 20px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.04); position: relative; text-align: center;
        }

