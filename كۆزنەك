        function setupShortsObserver() {
            const container = document.getElementById('shortsContainerList');
            if (!container) return;
            const items = container.querySelectorAll('.short-item-card');

            const observerOptions = {
                root: container,
                threshold: 0.7 
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    const mediaEl = entry.target.querySelector('.short-media-element');
                    if (!mediaEl) return;

                    if (entry.isIntersecting) {
                        if (mediaEl.tagName === 'VIDEO') {
                            mediaEl.play().catch(err => {});
                        } else if (mediaEl.tagName === 'IFRAME') {
                            try {
                                mediaEl.contentWindow.postMessage('{"event":"command","func":"playVideo","args":""}', '*');
                            } catch(e) {}
                        }
                    } else {
                        if (mediaEl.tagName === 'VIDEO') {
                            mediaEl.pause();
                            mediaEl.currentTime = 0;
                        } else if (mediaEl.tagName === 'IFRAME') {
                            try {
                                mediaEl.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
                            } catch(e) {}
                        }
                    }
                });
            }, observerOptions);

            items.forEach(item => observer.observe(item));
        }

