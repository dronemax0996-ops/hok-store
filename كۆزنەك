        .detail-page {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: var(--bg-color); z-index: 2000; overflow-y: auto; padding-bottom: 50px;
        }

        .detail-header {
            display: flex; align-items: center; padding: 15px 20px; background: var(--nav-bg);
            border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 10;
        }
        .back-btn { background: none; border: none; color: var(--accent-color); font-size: 15px; font-weight: 700; cursor: pointer; }

        .detail-player-box { width: 100%; aspect-ratio: 16/9; background-color: #000; position: relative; }
        .detail-player-box video, .detail-player-box iframe { width: 100%; height: 100%; border: none; object-fit: contain; }

        .detail-content-info { padding: 20px; }
        .detail-movie-title { font-size: 18px; font-weight: 700; color: var(--text-color); margin-bottom: 4px; }
        .detail-movie-date { font-size: 12px; color: var(--text-secondary); margin-bottom: 15px; }

        .detail-episodes-section { margin-top: 20px; }
        .detail-episodes-title { font-size: 14px; font-weight: 600; color: var(--text-secondary); margin-bottom: 10px; }
        .detail-episodes-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }

        .detail-ep-btn {
            background-color: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-color);
            padding: 10px 5px; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer; text-align: center;
        }
        .detail-ep-btn.active { background-color: var(--accent-color); border-color: var(--accent-color); color: white; }

        .related-section { margin-top: 30px; }
        .related-title { font-size: 15px; font-weight: 700; color: var(--text-color); margin-bottom: 12px; border-right: 3px solid var(--accent-color); padding-right: 8px; }

        .page-box { padding: 20px; max-width: 600px; margin: 0 auto; }
        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-size: 13px; color: var(--text-secondary); margin-bottom: 6px; font-weight: 500; }
        .form-input, .form-select {
            width: 100%; padding: 13px 15px; background-color: var(--card-bg);
            border: 1px solid var(--border-color); color: var(--text-color); border-radius: 10px; font-size: 14px; outline: none;
        }

        .action-btn {
            width: 100%; padding: 14px; background-color: var(--accent-color); color: white;
            border: none; border-radius: 10px; font-size: 15px; font-weight: 700; cursor: pointer; margin-top: 10px;
            box-shadow: 0 4px 12px rgba(229, 9, 20, 0.3); transition: background-color 0.2s;
        }
        .action-btn:hover { background-color: var(--accent-hover); }

        .swipe-wrapper { position: relative; overflow: hidden; border-radius: 10px; margin-bottom: 10px; background: #ff4757; }
        .swipe-delete-bg {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-color: #ff4757; color: white; display: flex; align-items: center;
            justify-content: flex-start; padding-left: 20px; font-weight: bold; font-size: 13px; z-index: 1;
        }
        .user-list-item {
            position: relative; background: var(--card-bg); border: 1px solid var(--border-color);
            border-radius: 10px; padding: 12px 16px; display: flex; justify-content: space-between;
            align-items: center; z-index: 2; touch-action: pan-y; user-select: none; cursor: pointer;
