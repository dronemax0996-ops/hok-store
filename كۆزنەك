        .short-item-card video, .short-item-card iframe {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border: none;
        }

        .short-overlay-info {
            position: absolute;
            bottom: 30px;
            right: 20px;
            left: 80px;
            color: #fff;
            z-index: 2;
            text-shadow: 0 2px 6px rgba(0,0,0,0.8);
            pointer-events: none;
        }

        .short-title-txt {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .short-desc-txt {
            font-size: 12px;
            color: #ddd;
        }

        .short-side-actions {
