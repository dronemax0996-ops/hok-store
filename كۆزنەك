    <style>
        :root {
            --bg-color: #f4f6f9;
            --nav-bg: rgba(255, 255, 255, 0.95);
            --text-color: #212529;
            --text-secondary: #6c757d;
            --card-bg: #ffffff;
            --border-color: #e9ecef;
            --accent-color: #E50914;
            --accent-hover: #b20710;
        }

        body.dark-mode {
            --bg-color: #121212;
            --nav-bg: rgba(18, 18, 18, 0.95);
            --text-color: #f1f1f1;
            --text-secondary: #a0a0a0;
            --card-bg: #1e1e1e;
            --border-color: #2c2c2c;
            --accent-color: #E50914;
            --accent-hover: #f40612;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            padding-bottom: 90px;
            direction: rtl;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .floating-contact-btn {
            position: fixed;
            bottom: 75px;
            left: 15px;
            background: linear-gradient(135deg, #0088cc, #00a2ff);
            color: white;
            padding: 10px 16px;
            border-radius: 25px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            box-shadow: 0 4px 15px rgba(0, 136, 204, 0.4);
            z-index: 999;
            transition: transform 0.2s;
            border: 1px solid rgba(255,255,255,0.2);
        }
        .floating-contact-btn:hover { transform: scale(1.05); }

        .popup-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-color: rgba(0, 0, 0, 0.75);
            display: flex; justify-content: center; align-items: center;
            z-index: 99999; animation: fadeIn 0.4s ease;
        }

        .popup-container {
            background: var(--card-bg);
            width: 90%; max-width: 420px;
            border-radius: 14px; overflow: hidden;
            position: relative;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
            text-align: center; color: var(--text-color);
            border: 1px solid var(--border-color);
        }

        .popup-close {
            position: absolute; top: 12px; right: 15px;
            background: rgba(128, 128, 128, 0.1);
            color: var(--text-color); border: none;
            width: 32px; height: 32px; border-radius: 50%;
            font-size: 22px; cursor: pointer; z-index: 10;
            display: flex; align-items: center; justify-content: center;
            transition: background 0.2s;
        }
        .popup-close:hover { background: #ff4757; color: #fff; }

        .popup-content { padding: 35px 25px 25px 25px; }
        .popup-content h2 { margin: 0 0 12px 0; font-size: 18px; color: var(--accent-color); }
        .popup-content p { margin: 0 0 22px 0; font-size: 14px; color: var(--text-secondary); line-height: 1.6; }

        .popup-btn-custom {
            background: linear-gradient(135deg, #ff4757, #ff6b81);
            color: white; border: none; padding: 12px 25px;
            font-size: 15px; font-weight: bold; border-radius: 8px;
            cursor: pointer; width: 100%;
            box-shadow: 0 4px 12px rgba(255, 71, 87, 0.3);
            transition: opacity 0.2s;
