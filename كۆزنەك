        function formatVideoUrl(url) {
            if (!url) return '';
            let cleanUrl = url.trim();
            
            if (cleanUrl.includes('vimeo.com')) {
                let match = cleanUrl.match(/(\d+)/);
                if (match) return `https://player.vimeo.com/video/${match[0]}`;
            }
            if (cleanUrl.includes('youtube.com') || cleanUrl.includes('youtu.be')) {
                let vId = '';
                if (cleanUrl.includes('watch?v=')) {
                    vId = cleanUrl.split('watch?v=')[1].split('&')[0];
                } else if (cleanUrl.includes('youtu.be/')) {
                    vId = cleanUrl.split('youtu.be/')[1].split('?')[0];
                } else if (cleanUrl.includes('/embed/')) {
                    let parts = cleanUrl.split('/embed/');
                    if (parts[1]) vId = parts[1].split('?')[0];
                } else if (cleanUrl.includes('/shorts/')) {
                    let parts = cleanUrl.split('/shorts/');
                    if (parts[1]) vId = parts[1].split('?')[0];
                }
                if (vId) return `https://www.youtube.com/embed/${vId}?autoplay=1&mute=0&enablejsapi=1`;
            }
            return cleanUrl;
        }

