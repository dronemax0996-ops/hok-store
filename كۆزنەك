                let mediaElement = '';
                if (formattedUrl.includes('vimeo.com') || formattedUrl.includes('youtube.com') || formattedUrl.includes('embed')) {
                    let cleanEmbedUrl = formattedUrl;
                    if (cleanEmbedUrl.includes('autoplay=1')) {
                        cleanEmbedUrl = cleanEmbedUrl.replace('autoplay=1', 'autoplay=0');
                    }
                    if (!cleanEmbedUrl.includes('enablejsapi=1')) {
                        cleanEmbedUrl += (cleanEmbedUrl.includes('?') ? '&' : '?') + 'enablejsapi=1';
                    }
                    mediaElement = `<iframe class="short-media-element" src="${cleanEmbedUrl}" allow="autoplay" allowfullscreen></iframe>`;
                } else {
                    mediaElement = `<video class="short-media-element" src="${formattedUrl}" playsinline loop preload="metadata"></video>`;
                }

                container.innerHTML += `
                    <div class="short-item-card">
                        ${mediaElement}
                        <div class="short-overlay-info">
                            <div class="short-title-txt">${movie.title}</div>
