            let relatedList = movies.filter(m => m.cat === currentMovie.cat && m.id !== currentMovie.id).slice().reverse().slice(0, 6);

            if (relatedList.length === 0) {
                relatedGrid.innerHTML = '<div style="color: var(--text-secondary); font-size: 13px; grid-column: span 2;">بۇ تۈردە باشقا فىلىم يوق</div>';
                return;
            }

            relatedList.forEach(movie => {
                const isLiked = favorites.includes(movie.id);
                const isVipMovie = movie.access === 'vip';
                const seriesBadge = movie.isSeries ? `<div class="movie-tag" style="background:#2ed573; left:10px; right:auto;">📺 ${movie.totalEpisodes} قىسىم</div>` : '';
                
                relatedGrid.innerHTML += `
                    <div class="movie-card">
                        ${isVipMovie ? '<div class="movie-tag">⭐ VIP</div>' : ''}
                        ${seriesBadge}
                        <img src="${movie.img}" class="movie-poster" onerror="this.src='https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=300&q=80'" onclick="handleCardClick('${movie.id}')">
                        <div class="movie-footer">
                            <div class="movie-name">${movie.title}</div>
                            <div class="card-actions">
                                <button class="fav-btn ${isLiked ? 'liked' : ''}" onclick="event.stopPropagation(); toggleFav('${movie.id}')">❤️</button>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        function playInDetailPlayer(url) {
            const playerBox = document.getElementById('detailPlayerBox');
            playerBox.innerHTML = '';
            
            let formattedUrl = formatVideoUrl(url);

            if (formattedUrl.includes('vimeo.com') || formattedUrl.includes('youtube.com') || formattedUrl.includes('embed')) {
                const iframeEl = document.createElement('iframe');
                iframeEl.src = formattedUrl; 
                iframeEl.allowFullscreen = true;
                playerBox.appendChild(iframeEl);
            } else {
                const videoEl = document.createElement('video');
                videoEl.src = formattedUrl; 
                videoEl.controls = true; 
                videoEl.autoplay = true;
                playerBox.appendChild(videoEl);
            }
        }

        function closeDetailPage() {
            document.getElementById('detailPlayerBox').innerHTML = '';
            detailPage.style.display = 'none';
        }

        function openSearch() {
            searchModal.style.display = 'block'; searchInput.focus(); filterMovies();
        }

        function closeSearch() {
            searchModal.style.display = 'none'; searchInput.value = ''; searchResults.innerHTML = '';
        }

        function switchTab(tabId, btnElement) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active-tab'));
            document.getElementById(tabId).classList.add('active-tab');
            document.querySelectorAll('.nav-item').forEach(btn => btn.classList.remove('active'));
            if (btnElement) btnElement.classList.add('active');
            
            if (tabId !== 'shortsTab') {
                document.querySelectorAll('.shorts-container video').forEach(v => { v.pause(); });
            }

            if (tabId === 'uploadTab') checkAdminPermissions();
            if (tabId === 'shortsTab') renderShortsFeed();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleFav(id) {
            if (favorites.includes(id)) {
                favorites = favorites.filter(favId => favId !== id);
            } else {
                favorites.push(id);
            }
            try {
                localStorage.setItem('koznek_favs', JSON.stringify(favorites));
            } catch (e) {}
            renderHomeSections();
            renderShortsFeed();
        }

        function addNewMovie() {
            const titleInput = document.getElementById('newMovieTitle');
            if (!titleInput) return;
            const title = titleInput.value.trim();
            const cat = document.getElementById('newMovieCat').value;
            const access = document.getElementById('newMovieAccess').value;

            if (!title) {
                alert('مەزمۇن نامىنى چوقۇم كىرگۈزۈڭ!'); return;
            }
            if (!uploadedPosterBase64) {
                alert('تېلېفوندىن مۇقاۋا رەسىم تاللاڭ!'); return;
            }

            const isSeries = (cat === 'series' || cat === 'cartoon_series');
            let episodesArr = [];
            let totalEpCount = 1;
            let singleVideoInput = document.getElementById('newMovieUrl');
            let singleVideoUrl = singleVideoInput && singleVideoInput.value.trim() ? singleVideoInput.value.trim() : '';

            if (isSeries) {
                let totalCountInput = document.getElementById('seriesTotalCount');
                totalEpCount = totalCountInput ? parseInt(totalCountInput.value) || 5 : 5;
                for (let i = 1; i <= totalEpCount; i++) {
                    let epInput = document.getElementById(`ep_url_${i}`);
                    let epUrl = epInput && epInput.value.trim() ? epInput.value.trim() : '';
                    episodesArr.push({
                        epNum: i,
                        url: epUrl
                    });
                }
            }

            const newMovieObj = {
                id: Date.now().toString(),
                title: title,
                cat: cat,
                access: access,
                img: uploadedPosterBase64,
                url: isSeries ? (episodesArr[0] ? episodesArr[0].url : '') : singleVideoUrl,
                isSeries: isSeries,
                totalEpisodes: isSeries ? totalEpCount : 1,
                episodes: isSeries ? episodesArr : []
            };

            movies.push(newMovieObj);

            const moviesRef = window.dbRef(window.db, 'koznek_movies');
            window.dbSet(moviesRef, movies).then(() => {
                alert('مەزمۇن مۇۋەپپەقىيەتلىك تورغا يوللاندى!');
                uploadedPosterBase64 = "";
                switchTab('homeTab', document.querySelector('.nav-item'));
            });
        }

        function deleteMovie(id) {
            if (confirm('بۇ مەزمۇننى راستلا توردىن ئۆچۈرەمسىز?')) {
                movies = movies.filter(m => m.id !== id);
                favorites = favorites.filter(favId => favId !== id);
                try {
                    localStorage.setItem('koznek_favs', JSON.stringify(favorites));
                } catch (e) {}

                const moviesRef = window.dbRef(window.db, 'koznek_movies');
                window.dbSet(moviesRef, movies).then(() => {
                    renderHomeSections();
                    renderShortsFeed();
                });
            }
        }

        function filterMovies() {
            const query = searchInput.value.toLowerCase().trim();
            searchResults.innerHTML = '';
            let found = false;
            movies.forEach(movie => {
                if (movie.title.toLowerCase().includes(query)) {
                    found = true;
                    const isVip = movie.access === 'vip';
                    const item = document.createElement('div');
                    item.className = 'search-item';
                    item.innerHTML = `
                        <img src="${movie.img}" onerror="this.src='https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=300&q=80'">
                        <div class="search-item-title">${movie.title} ${isVip ? '⭐' : ''} ${movie.isSeries ? `(📺 ${movie.totalEpisodes} قىسىم)` : ''}</div>
                    `;
                    item.onclick = () => {
                        closeSearch();
                        handleCardClick(movie.id);
                    };
                    searchResults.appendChild(item);
                }
            });
            if (!found && query !== '') {
                searchResults.innerHTML = '<div style="color: var(--text-secondary); text-align: center; margin-top: 30px;">ھېچقانداق مەزمۇن تېپىلمىدى</div>';
            }
        }

        function handleLoginOrRegister() {
            const usernameInput = document.getElementById('loginUser');
            const passwordInput = document.getElementById('loginPass');
            if (!usernameInput || !passwordInput) return;
            const username = usernameInput.value.trim();
            const password = passwordInput.value.trim();

            if (!username || !password) {
                alert('ئابونت ئىسمى ۋە پارولنى تولدۇرۇڭ!'); return;
            }
            if (username.toLowerCase() === ADMIN_USERNAME) {
                if (password === ADMIN_MASTER_PASS) {
                    currentUser = { name: ADMIN_USERNAME, vipExpire: 8640000000000000, avatar: '' };
                    try {
                        localStorage.setItem('koznek_current_user', JSON.stringify(currentUser));
                    } catch (e) {}
                    checkAdminPermissions(); updateAccountUI(); renderHomeSections(); renderShortsFeed();
                    alert('خۇش كەپسىز باشقۇرغۇچى (nasrulla)!'); return;
                } else { alert('باشقۇرغۇچى پارولى خاتالىق!'); return; }
            }
            if (password === ADMIN_MASTER_PASS) {
                alert('بۇ مەخپىي نومۇر باشقۇرغۇچىغا تەۋە!'); return;
            }

            let foundKey = null;
            for (let key in globalUsersDb) {
                if (key.trim().toLowerCase() === username.toLowerCase()) { foundKey = key; break; }
            }

            if (foundKey) {
                if (globalUsersDb[foundKey].password === password) {
                    currentUser = { 
                        name: foundKey, 
                        vipExpire: globalUsersDb[foundKey].vipExpire || 0,
                        avatar: globalUsersDb[foundKey].avatar || ''
                    };
                    try {
                        localStorage.setItem('koznek_current_user', JSON.stringify(currentUser));
                    } catch (e) {}
                    checkAdminPermissions(); updateAccountUI(); alert('مۇۋەپپەقىيەتلىك كىردىڭىز!');
                } else { alert('پارول خاتالىق!'); }
            } else {
                const newUserRef = window.dbRef(window.db, 'koznek_users_db/' + username);
                window.dbSet(newUserRef, { password: password, vipExpire: 0, avatar: '' }).then(() => {
                    currentUser = { name: username, vipExpire: 0, avatar: '' };
                    try {
                        localStorage.setItem('koznek_current_user', JSON.stringify(currentUser));
                    } catch (e) {}
                    checkAdminPermissions(); 
                    updateAccountUI(); 
                    alert('يېڭى ھېسابات توردا مۇۋەپپەقىيەتلىك تىزىملىتىلدى!');
                });
            }
        }

        function handleLogout() {
            try {
                localStorage.removeItem('koznek_current_user');
            } catch (e) {}
            currentUser = null;
            checkAdminPermissions(); updateAccountUI(); renderHomeSections(); renderShortsFeed();
            alert('ھېساباتتىن چېكىندىڭىز.');
        }

        function updateAccountUI() {
            const loginForm = document.getElementById('loginForm');
            const userProfileView = document.getElementById('userProfileView');
            const displayUsername = document.getElementById('displayUsername');
            const accountTitle = document.getElementById('accountTitle');
            const vipBadge = document.getElementById('vipBadge');
            const vipStatusText = document.getElementById('vipStatusText');
            
            const settingsProfileName = document.getElementById('settingsProfileName');
            const settingsProfileDesc = document.getElementById('settingsProfileDesc');
            const settingsAvatarBox = document.getElementById('settingsAvatarBox');
            const mainAccountAvatarBox = document.getElementById('mainAccountAvatarBox');

            if (currentUser) {
                loginForm.style.display = 'none';
                userProfileView.style.display = 'block';
                displayUsername.innerText = currentUser.name;
                accountTitle.innerText = 'شەخسىي ھېسابات';

                if (settingsProfileName) settingsProfileName.innerText = currentUser.name;
                
                if (currentUser.avatar && currentUser.avatar.trim() !== '') {
                    if (mainAccountAvatarBox) mainAccountAvatarBox.innerHTML = `<img src="${currentUser.avatar}" onerror="this.parentElement.innerHTML='👤'">`;
                    if (settingsAvatarBox) settingsAvatarBox.innerHTML = `<img src="${currentUser.avatar}" onerror="this.parentElement.innerHTML='👤'">`;
                } else {
                    if (mainAccountAvatarBox) mainAccountAvatarBox.innerHTML = '👤';
                    if (settingsAvatarBox) settingsAvatarBox.innerHTML = '👤';
                }

                if (settingsProfileDesc) {
                    if (currentUser.name.toLowerCase() === ADMIN_USERNAME) {
                        settingsProfileDesc.innerText = '⭐ باشقۇرغۇچى ھوقۇقى';
                    } else {
                        let now = new Date().getTime();
                        if (currentUser.vipExpire && currentUser.vipExpire > now) {
                            settingsProfileDesc.innerText = '⭐ VIP ئەزا ئاكتىپ';
                        } else {
                            settingsProfileDesc.innerText = 'ئادەتتىكى ئەزا';
                        }
                    }
                }

                if (currentUser.name.toLowerCase() === ADMIN_USERNAME) {
                    vipBadge.innerText = '⭐ باشقۇرغۇچى (Admin)';
                    vipBadge.style.background = '#E50914';
                    vipStatusText.innerText = 'ھوقۇقى: پۈتۈن مەزمۇن ۋە ئەزالارنى باشقۇرۇش ئوچۇق';
                    return;
                }

                let now = new Date().getTime();
                if (currentUser.vipExpire && currentUser.vipExpire > now) {
                    let diffMs = currentUser.vipExpire - now;
                    let leftDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
                    let leftHours = Math.floor((diffMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    vipBadge.innerText = '⭐ VIP ئەزا';
                    vipBadge.style.background = '#ffa502';
                    vipStatusText.innerText = 'ئەزالىق قالغان ۋاقتى: ' + leftDays + ' كۈن ' + leftHours + ' سائەت';
                } else {
                    vipBadge.innerText = 'ئادەتتىكى ئەزا';
                    vipBadge.style.background = '#555';
                    vipStatusText.innerText = 'ئەزالىق ۋاقتى توشقان ياكى ئاكتىپلانمىغان';
                }
            } else {
                loginForm.style.display = 'block';
                userProfileView.style.display = 'none';
                accountTitle.innerText = 'ھېساباتقا كىرىش / تىزىملىتىش';

                if (settingsProfileName) settingsProfileName.innerText = 'مېھمان ئابونت';
                if (settingsProfileDesc) settingsProfileDesc.innerText = 'تېخىمۇ كۆپ ئىقتىدار ئۈچۈن كىرىڭ';
                if (settingsAvatarBox) settingsAvatarBox.innerHTML = '👤';
                if (mainAccountAvatarBox) mainAccountAvatarBox.innerHTML = '👤';
            }
        }
    </script>
</body>
